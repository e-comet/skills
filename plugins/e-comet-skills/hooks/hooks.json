{
  "description": "Preserve signed e-Comet browser-job authorizations between remote and local MCP calls.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__.+__browser_job$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/browser-job-handoff.mjs\"",
            "timeout": 10,
            "statusMessage": "Securing e-Comet browser authorization"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(?:(?:remote-devices__)?plugin_e-comet-skills_)?e[-_]comet[-_]local__(?:wb_product_card|wb_search_by_query|wb_check_by_query|wb_recommendations_by_product|wb_seller_reviews)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/browser-job-handoff.mjs\"",
            "timeout": 10,
            "statusMessage": "Restoring e-Comet browser authorization"
          }
        ]
      },
      {
        "matcher": "^mcp__(?:(?:(?:remote-devices__)?plugin_e-comet-skills_)?e[-_]comet(?:[-_]local)?__.+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}__(?:info|describe_metrics|list_entities|query_metrics|query_forecast|browser_job))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.mjs\"",
            "timeout": 4,
            "statusMessage": "Checking e-Comet MCP Tools plugin version"
          }
        ]
      }
    ]
  }
}
